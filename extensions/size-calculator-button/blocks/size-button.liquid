{% if product %}
  {% liquid
    assign cariana_size_mode = ''
    if product.tags contains 'mujer' and product.tags contains 'vestido'
      assign cariana_size_mode = 'woman_dress'
    elsif product.tags contains 'mujer' and product.tags contains 'superior'
      assign cariana_size_mode = 'woman_top'
    elsif product.tags contains 'mujer' and product.tags contains 'inferior'
      assign cariana_size_mode = 'woman_bottom'
    elsif product.tags contains 'hombre' and product.tags contains 'superior'
      assign cariana_size_mode = 'man_top'
    elsif product.tags contains 'hombre' and product.tags contains 'inferior'
      assign cariana_size_mode = 'man_bottom'
    endif
  %}

  {% if cariana_size_mode != blank %}
  <div
    class="cariana-size-button-host"
    data-cariana-size-root
    data-cariana-size-mode="{{ cariana_size_mode }}"
    data-cariana-chest-guide-image="{{ 'chest-measure-guide.png' | asset_url }}"
    data-cariana-waist-guide-image="{{ 'waist-measure-guide.png' | asset_url }}"
    data-cariana-hip-guide-image="{{ 'hip-measure-guide.png' | asset_url }}"
    data-cariana-man-chest-guide-image="{{ 'man-chest-measure-guide.png' | asset_url }}"
    data-cariana-man-waist-guide-image="{{ 'man-waist-measure-guide.png' | asset_url }}"
    data-cariana-man-hip-guide-image="{{ 'man-hip-measure-guide.png' | asset_url }}"
  >
    <style>
      .cariana-size-button-host[data-cariana-size-root] .cariana-chest-guide-image,
      .cariana-size-button-host[data-cariana-size-root] .cariana-waist-guide-image {
        display: block !important;
        width: 100% !important;
        height: 178px !important;
        min-height: 178px !important;
        background-image: url("{{ 'chest-measure-guide.png' | asset_url }}") !important;
        background-repeat: no-repeat !important;
        background-position: center !important;
        background-size: contain !important;
        background-color: #ffffff !important;
      }

      .cariana-size-button-host[data-cariana-size-root] .cariana-waist-guide-image {
        background-image: url("{{ 'waist-measure-guide.png' | asset_url }}") !important;
      }

      .cariana-size-button-host[data-cariana-size-root] .cariana-chest-guide-image img,
      .cariana-size-button-host[data-cariana-size-root] .cariana-waist-guide-image img {
        display: block !important;
        width: 100% !important;
        height: 178px !important;
        min-height: 178px !important;
        object-fit: contain !important;
        background-color: #ffffff !important;
        opacity: 0 !important;
        visibility: hidden !important;
        position: static !important;
        transform: none !important;
      }
    </style>

    <button type="button" class="cariana-size-guide-link" data-cariana-size-guide>
      📏 Ver guía de tallas
    </button>

    <div class="cariana-size-button-wrapper">
      <button type="button" class="cariana-size-button" data-cariana-size-open>
        ¿No sabes tu talla? Descúbrela aquí
      </button>
    </div>

    <div class="cariana-size-modal" data-cariana-size-modal hidden>
      <div class="cariana-size-modal-card" role="dialog" aria-modal="true" aria-labelledby="carianaSizeTitle">
        <div class="cariana-size-screen" data-cariana-main-screen>
          <h3 id="carianaSizeTitle" class="cariana-size-title" data-cariana-title>Encuentra tu talla ideal</h3>

          <div class="cariana-size-fields" data-cariana-fields>
            <button type="button" class="cariana-size-field" data-cariana-weight data-placeholder="Peso kg">
              Peso kg
            </button>
            <button type="button" class="cariana-size-field" data-cariana-height data-placeholder="Altura cm">
              Altura cm
            </button>

            <button type="button" class="cariana-size-selector" data-cariana-body-button>
              Tipo de cuerpo <strong data-cariana-body-label></strong>
            </button>

            <button type="button" class="cariana-size-selector" data-cariana-extra-button>
              <span data-cariana-extra-text>Tamaño de busto</span> <strong data-cariana-extra-label></strong>
            </button>

            <button type="button" class="cariana-size-calculate" data-cariana-calculate>
              Ver mi talla
            </button>

            <p class="cariana-size-result" data-cariana-result></p>
          </div>

          <p class="cariana-size-pending" data-cariana-pending hidden>
            Esta calculadora todavia no esta configurada para este producto.
          </p>

          <button type="button" class="cariana-size-close-text" data-cariana-close>
            Cerrar
          </button>
        </div>

        <div class="cariana-size-screen cariana-size-screen-hidden" data-cariana-selector-screen>
          <div class="cariana-size-topbar">
            <button type="button" class="cariana-size-icon-btn" data-cariana-back aria-label="Volver">&larr;</button>
            <strong>Selecciona</strong>
            <button type="button" class="cariana-size-icon-btn cariana-size-icon-close" data-cariana-close aria-label="Cerrar">&times;</button>
          </div>

          <div class="cariana-size-selector-title" data-cariana-selector-title></div>
          <div data-cariana-selector-content></div>

          <div class="cariana-size-actions">
            <button type="button" class="cariana-size-save" data-cariana-save>
              Guardar
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="{{ 'size-button-v2.js' | asset_url }}?cariana_v=130" defer></script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Boton talla ideal",
  "target": "section",
  "stylesheet": "size-button-v2.css",
  "settings": []
}
{% endschema %}
